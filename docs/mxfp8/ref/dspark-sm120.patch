+@triton.jit
+def _sm120_write_kv_kernel(K, V, KC, VC, SLOT, sk_t, sk_h, sv_t, sv_h,
+                           sc_b, sc_p, sc_h, PAGE: tl.constexpr, D: tl.constexpr):
+    # One program per (token, kv head): copy K/V rows into the paged cache.
+    t = tl.program_id(0).to(tl.int64)
+    h = tl.program_id(1).to(tl.int64)
+    slot = tl.load(SLOT + t).to(tl.int64)
+    if slot < 0:
+        return
+    blk = slot // PAGE
+    off = slot % PAGE
+    d = tl.arange(0, D)
+    dst = blk * sc_b + off * sc_p + h * sc_h + d
+    tl.store(KC + dst, tl.load(K + t * sk_t + h * sk_h + d))
+    tl.store(VC + dst, tl.load(V + t * sv_t + h * sv_h + d))
+
+
+def _sm120_write_kv(k, v, kv_cache, head_dim, slot_mapping):
+    """reshape_and_cache_flash replacement for the draft's (B, H, page, 2D)
+    bf16 cache: this vLLM build ships no sm_120 kernel for that layout."""
+    key_cache, value_cache = kv_cache.transpose(1, 2).split(head_dim, dim=-1)
+    n = slot_mapping.shape[0]
+    if n == 0:
+        return
+    assert key_cache.stride(3) == 1 and k.stride(2) == 1 and v.stride(2) == 1
+    assert key_cache.stride() == value_cache.stride()
+    _sm120_write_kv_kernel[(n, k.shape[1])](
+        k, v, key_cache, value_cache, slot_mapping,
+        k.stride(0), k.stride(1), v.stride(0), v.stride(1),
+        key_cache.stride(0), key_cache.stride(1), key_cache.stride(2),
+        PAGE=key_cache.shape[1], D=head_dim,
+    )
+
